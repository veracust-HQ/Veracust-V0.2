# Required for the current Supabase-authenticated API.
# For customer isolation, use a Supabase project controlled by the customer.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Comma-separated browser origins allowed to call this API.
# Example: https://veracust-customer.example.com
FRONTEND_ORIGIN=http://localhost:3000

# Optional: change only if your deployment platform requires another port.
PORT=8000
