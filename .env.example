# Customer Docker deployment settings.
# Veracust's hosted control plane authorizes and meters each private inspection.
VERACUST_CONTROL_PLANE_URL=https://veracust-v0-2.onrender.com
VERACUST_DEPLOYMENT_TOKEN=PASTE_THE_ONE_TIME_DEPLOYMENT_TOKEN_HERE

# Optional: required only if you also use the hosted-demo account routes in this container.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
FRONTEND_ORIGIN=http://localhost:3000

PORT=8000

# NEVER place SUPABASE_SERVICE_ROLE_KEY or VERACUST_ADMIN_API_KEY in this customer file.
